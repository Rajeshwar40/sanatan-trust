PORT=4000
CORS_ORIGIN=http://localhost:5500
JWT_SECRET=replace-with-a-long-random-string
ADMIN_USER=admin
ADMIN_PASS=change-this-before-first-run
NODE_ENV=development

# Optional: point at a Turso database instead of a local file.
# Leave both blank for local dev (uses backend/data.sqlite automatically).
# Required in production so data survives Render's ephemeral disk.
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token
